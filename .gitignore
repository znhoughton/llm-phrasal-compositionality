# Track the paper source, the rendered PDF and the script that builds its results;
# ignore everything else under paper/ (figures, logs, the 54 generated results CSVs,
# the submission zip). "paper/*" rather than "paper/": git does not descend into an
# ignored directory, so a plain "paper/" cannot be negated per file.
paper/*
!paper/.gitignore
!paper/writeup.qmd
!paper/writeup.pdf
!paper/prepare_results.R
!paper/references.bib
**/__pycache__/
*.pyc
.ipynb_checkpoints/
**/.ipynb_checkpoints/
Analyses/analysis-script.html
**/all_layers_results.csv
# Whisper's are small enough (~13MB) to track normally, unlike OLMo/BabyLM's
!Data/whisper/**/all_layers_results.csv
!Data/whisper_subword/**/all_layers_results.csv

# Pipeline backups of the pre-filter results (~327MB each, regenerable).
*.pre-filter-bak
